# 仅示例，复制为 .env 后在本机填写；不要提交 .env，不使用 mykeys.py。
# fake=固定假回复，demo=无 API 规则模拟，real=真实模型（可能收费）。
ORDERBOT_MODE=demo
# zhipu：固定免费 glm-4.7-flash / Chat Completions；openai：保留原 Responses 适配。
ORDERBOT_PROVIDER=zhipu
# 只在本机填写真实密钥，不发送到聊天中。
ZHIPU_API_KEY=PASTE_ZHIPU_API_KEY_HERE
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 以下 OPENAI_* 只供主动选用原 Responses 后端，智谱分支绝不使用或回退到它。
OPENAI_MODEL=
OPENAI_API_KEY=
# 留空使用 https://api.openai.com/v1；自定义服务必须兼容 Responses 和工具调用。
# 填接口前缀（如 https://服务域名/v1），不要填 /responses 或 /chat/completions。
OPENAI_BASE_URL=
# 每次请求的网络超时秒数：1—60；不是整轮对话的硬性总时限。
ORDERBOT_TIMEOUT_SECONDS=20
# 原 Responses 后端 SDK 重试次数：0—1；智谱固定零自动重试。
ORDERBOT_MAX_RETRIES=0
# 每次响应输出上限（含推理 tokens）：64—4096。
ORDERBOT_MAX_OUTPUT_TOKENS=800
# 每次用户发送的工具执行轮次：1—10；模型判断次数：1—11。
ORDERBOT_MAX_TOOL_ROUNDS=4
ORDERBOT_MAX_MODEL_CALLS=5
# 当前页面会话内的请求尝试上限：1—200。新对话重置；不是账户费用额度。
ORDERBOT_MAX_SESSION_REQUESTS=20
# 单次请求消息历史和指令的字符上限：1000—100000（不是 tokens）。
ORDERBOT_MAX_INPUT_CHARS=40000
